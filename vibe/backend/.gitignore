# ==========================================
# SAYLO Backend Server (.gitignore)
# Tech Stack: Node.js, Express, MongoDB/Mongoose
# ==========================================

# 1. Dependencies
node_modules/

# 2. Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# 3. Database Dumps & Local Data
mongo-data/
data/
dump/
*.dump
*.sqlite
*.sqlite3
*.db

# 4. Uploads & Temporary Storage
uploads/
temp/
tmp/
storage/

# 5. Logs & Process Information
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.seed

# 6. Certificates & Secret Keys
*.pem
*.key
*.cert
*.crt

# 7. Testing & Coverage
coverage/
.nyc_output/

# 8. Editor & Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# IDEs & Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
